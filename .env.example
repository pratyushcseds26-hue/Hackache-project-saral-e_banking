# =====================================================================
# Saral Banking - Environment Configuration Template
# =====================================================================
# To enable real AI banking assistance:
# 1. Copy this file to .env:
#      copy .env.example .env     (on Windows PowerShell / CMD)
#      cp .env.example .env       (on macOS / Linux)
# 2. Add your Google Gemini API key into the .env file:
#      Get a free Gemini API key at: https://aistudio.google.com/app/apikey
# 3. Restart the server with `start.bat` or `python server.py 8000`.
#
# NOTE: Never commit your real secret keys to .env.example or Git.
# Keep your secret keys only in .env!
# =====================================================================

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Fallback: OpenAI API Key (if preferred over Gemini)
# OPENAI_API_KEY=your_openai_api_key_here

# Local Server Port (default: 8000)
PORT=8000
